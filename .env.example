# =============================================================================
# BIPE Website — environment variables
# =============================================================================
# Copy this file to `.env.local` for local development. For production, add
# the same variables in Vercel → Project Settings → Environment Variables.

# -----------------------------------------------------------------------------
# SMTP — emailer for the /apply and /contact forms
# -----------------------------------------------------------------------------
# Form submissions are delivered straight via SMTP using nodemailer. Plug in
# any SMTP server — Gmail, Office365, Zoho, an institutional mail relay,
# AWS SES SMTP, etc. No third-party HTTP service in the path.
#
# Required:
#   SMTP_HOST   — e.g. smtp.gmail.com / smtp.office365.com / smtp.zoho.in
#   SMTP_PORT   — 587 (STARTTLS, recommended) or 465 (SMTPS)
#   SMTP_USER   — login username (usually the same address as SMTP_FROM)
#   SMTP_PASS   — password or app-specific password
#
# Optional:
#   SMTP_FROM   — From: address (defaults to SMTP_USER)
#   SMTP_TO     — admissions inbox (defaults to SMTP_FROM)
#   SMTP_SECURE — "true" forces TLS (port 465); auto-detected otherwise.
#
# If any of the four required vars is unset, the form pretends success and
# logs the payload to the server console — useful for local dev without an
# SMTP account.

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_TO=
# SMTP_SECURE=true

# -----------------------------------------------------------------------------
# BIPE backend (Django REST Framework — separate repo / host)
# -----------------------------------------------------------------------------
# When set, every accepted form submission is also POSTed to the DRF
# backend so it shows up in the admin dashboard. Failures are logged
# but never block the public form (email path stays the source of truth).
#
# Leave empty in environments where the backend isn't deployed.
BIPE_BACKEND_URL=
BIPE_INGEST_TOKEN=

# -----------------------------------------------------------------------------
# Admin dashboard (/admin) — public API base URL the React code calls
# -----------------------------------------------------------------------------
# Must be NEXT_PUBLIC_* so it's exposed to the browser. Points at the same
# backend as BIPE_BACKEND_URL above, with the /api/v1 suffix.
NEXT_PUBLIC_API_BASE_URL=https://api.bipevns.org/api/v1

# -----------------------------------------------------------------------------
# Cloudinary — used by the admin <ImageInput> for the "Browse" upload path
# -----------------------------------------------------------------------------
# When set, the admin image editors (events, faculty, recruiters,
# testimonials, branches) show a "Browse" button that uploads the chosen
# file straight to Cloudinary via an unsigned upload preset. The
# returned secure_url is normalised to include f_auto,q_auto so every
# delivered image is AVIF/WebP without burning Vercel's image quota.
#
# Setup (in your Cloudinary dashboard):
#   1. Settings → Upload → Add upload preset
#   2. Mode: Unsigned
#   3. Folder: bipe/admin (optional, keeps uploads tidy)
#   4. Copy the preset name into NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET
#
# If NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET is empty, the Browse button is
# hidden and editors fall back to URL-only entry (no breakage).
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=dg8sty5ej
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# -----------------------------------------------------------------------------
# Double Tick — WhatsApp Business template-message confirmation sender
# -----------------------------------------------------------------------------
# When configured, every accepted /apply, /contact, /visit form submission
# triggers a Double Tick template message back to the submitter's phone so
# they get an immediate WhatsApp confirmation. The send is fire-and-forget
# from inside /api/submit — failures are logged but never block the form
# response.
#
# All four DT vars are independently optional. Behaviour by combination:
#   DOUBLETICK_API_KEY missing                     → DT calls are no-ops
#                                                    (form still works)
#   DOUBLETICK_API_KEY set + DOUBLETICK_FROM_NUMBER missing
#                                                  → no-op + warning logged
#   per-form template env vars missing             → that form type's
#                                                    confirmation is skipped
#
# Approved-template names must be set up in the Double Tick dashboard
# first (https://app.doubletick.io), then their names plugged in below.
# Until that happens these vars stay empty and confirmations don't fire.

# 29 May 2026 — the approved template "enquiry_s_v1_submitted" is now
# the hardcoded default (in lib/doubleTick.ts). Its body has 4
# placeholders:
#   {{1}}  →  first name
#   {{2}}  →  reference ID "BIPE/{TYPE}/YYYY/NN"
#   {{3}}  →  course / branch of interest
#   {{4}}  →  callback timeline in hours (default "24")
#
# Setting any of the DOUBLETICK_TEMPLATE_* vars below overrides the
# default for that form type — useful when a per-form template (e.g.
# apply_s_v1_submitted, visit_s_v1_confirmed) gets approved later.

DOUBLETICK_API_KEY=
DOUBLETICK_FROM_NUMBER=
DOUBLETICK_TEMPLATE_APPLY_RECEIVED=
DOUBLETICK_TEMPLATE_ENQUIRY_RECEIVED=
DOUBLETICK_TEMPLATE_VISIT_RECEIVED=
DOUBLETICK_TEMPLATE_LANGUAGE=en
