# =============================================================================
# BIPE Website — environment variables
# =============================================================================
# Copy this file to `.env.local` for local development. For production, add
# the same variables in Vercel → Project Settings → Environment Variables.

# -----------------------------------------------------------------------------
# Web3Forms — emailer for the /apply and /contact forms
# -----------------------------------------------------------------------------
# Form submissions are sent to admissions@bipevns.org via the Web3Forms
# free transactional email gateway. No SMTP, no domain verification needed.
#
# How to set this up (one-time, ~2 minutes):
#   1. Visit https://web3forms.com
#   2. Sign up with the destination email — admissions@bipevns.org
#      (or sign up with any email and configure forwarding from
#      Web3Forms → Dashboard → Settings)
#   3. Copy the access key from the dashboard
#   4. Paste below (and add the same value to Vercel project env vars)
#
# Free tier: 250 form submissions/month. Upgrade only if needed.
#
# If this variable is unset, the form pretends success and logs the
# payload to the server console — useful for local dev without an account.

WEB3FORMS_ACCESS_KEY=
