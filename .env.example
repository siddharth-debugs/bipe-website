# =============================================================================
# BIPE Website — environment variables
# =============================================================================
# Copy this file to `.env.local` for local development. For production, add
# the same variables in Vercel → Project Settings → Environment Variables.

# -----------------------------------------------------------------------------
# SMTP — emailer for the /apply and /contact forms
# -----------------------------------------------------------------------------
# Form submissions are delivered straight via SMTP using nodemailer. Plug in
# any SMTP server — Gmail, Office365, Zoho, an institutional mail relay,
# AWS SES SMTP, etc. No third-party HTTP service in the path.
#
# Required:
#   SMTP_HOST   — e.g. smtp.gmail.com / smtp.office365.com / smtp.zoho.in
#   SMTP_PORT   — 587 (STARTTLS, recommended) or 465 (SMTPS)
#   SMTP_USER   — login username (usually the same address as SMTP_FROM)
#   SMTP_PASS   — password or app-specific password
#
# Optional:
#   SMTP_FROM   — From: address (defaults to SMTP_USER)
#   SMTP_TO     — admissions inbox (defaults to SMTP_FROM)
#   SMTP_SECURE — "true" forces TLS (port 465); auto-detected otherwise.
#
# If any of the four required vars is unset, the form pretends success and
# logs the payload to the server console — useful for local dev without an
# SMTP account.

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_TO=
# SMTP_SECURE=true

# -----------------------------------------------------------------------------
# BIPE backend (Django REST Framework — separate repo / host)
# -----------------------------------------------------------------------------
# When set, every accepted form submission is also POSTed to the DRF
# backend so it shows up in the admin dashboard. Failures are logged
# but never block the public form (email path stays the source of truth).
#
# Leave empty in environments where the backend isn't deployed.
BIPE_BACKEND_URL=
BIPE_INGEST_TOKEN=

# Sampark CRM forward (2026-08-11) — every accepted BIPE form submission is
# ALSO POSTed to the College-CRM so it lands in the consultant inbox as a
# BIPE lead (auto-ack, unreachable ramp, cross-refer), alongside the BIPE
# backend above. Fire-and-forget: a CRM outage never blocks a form. Both
# unset → the forward silently no-ops.
#   URL: the CRM bite-leads webhook.  KEY: == BITE_LEADS_API_KEY on the CRM.
BIPE_CRM_WEBHOOK_URL=https://crm-backend.bitevns.org/api/v1/integrations/bite-leads/
BIPE_CRM_API_KEY=

# -----------------------------------------------------------------------------
# Admin dashboard (/admin) — public API base URL the React code calls
# -----------------------------------------------------------------------------
# Must be NEXT_PUBLIC_* so it's exposed to the browser. Points at the same
# backend as BIPE_BACKEND_URL above, with the /api/v1 suffix.
NEXT_PUBLIC_API_BASE_URL=https://api.bipevns.org/api/v1

# -----------------------------------------------------------------------------
# Cloudinary — used by the admin <ImageInput> for the "Browse" upload path
# -----------------------------------------------------------------------------
# When set, the admin image editors (events, faculty, recruiters,
# testimonials, branches) show a "Browse" button that uploads the chosen
# file straight to Cloudinary via an unsigned upload preset. The
# returned secure_url is normalised to include f_auto,q_auto so every
# delivered image is AVIF/WebP without burning Vercel's image quota.
#
# Setup (in your Cloudinary dashboard):
#   1. Settings → Upload → Add upload preset
#   2. Mode: Unsigned
#   3. Folder: bipe/admin (optional, keeps uploads tidy)
#   4. Copy the preset name into NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET
#
# If NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET is empty, the Browse button is
# hidden and editors fall back to URL-only entry (no breakage).
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=dg8sty5ej
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# -----------------------------------------------------------------------------
# Double Tick — WhatsApp Business template-message confirmation sender
# -----------------------------------------------------------------------------
# When configured, every accepted /apply, /contact, /visit form submission
# triggers a Double Tick template message back to the submitter's phone so
# they get an immediate WhatsApp confirmation. The send is fire-and-forget
# from inside /api/submit — failures are logged but never block the form
# response.
#
# All four DT vars are independently optional. Behaviour by combination:
#   DOUBLETICK_API_KEY missing                     → DT calls are no-ops
#                                                    (form still works)
#   DOUBLETICK_API_KEY set + DOUBLETICK_FROM_NUMBER missing
#                                                  → no-op + warning logged
#   per-form template env vars missing             → that form type's
#                                                    confirmation is skipped
#
# Approved-template names must be set up in the Double Tick dashboard
# first (https://app.doubletick.io), then their names plugged in below.
# Until that happens these vars stay empty and confirmations don't fire.

# 29 May 2026 — the approved template "enquiry_s_v1_submitted" is now
# the hardcoded default (in lib/doubleTick.ts). Its body has 4
# placeholders:
#   {{1}}  →  first name
#   {{2}}  →  reference ID "BIPE/{TYPE}/YYYY/NN"
#   {{3}}  →  course / branch of interest
#   {{4}}  →  callback timeline in hours (default "24")
#
# Setting any of the DOUBLETICK_TEMPLATE_* vars below overrides the
# default for that form type — useful when a per-form template (e.g.
# apply_s_v1_submitted, visit_s_v1_confirmed) gets approved later.

DOUBLETICK_API_KEY=
DOUBLETICK_FROM_NUMBER=
DOUBLETICK_TEMPLATE_APPLY_RECEIVED=
DOUBLETICK_TEMPLATE_ENQUIRY_RECEIVED=
DOUBLETICK_TEMPLATE_VISIT_RECEIVED=
DOUBLETICK_TEMPLATE_LANGUAGE=en

# -----------------------------------------------------------------------------
# Alumni introduction request — admin WhatsApp notification
# -----------------------------------------------------------------------------
# Per user direction 29 May 2026, alumni-introduction-request submissions
# from /alumni do NOT land in the Django backend dashboard. They go
# straight to the BIPE admin (placement cell / TPO) over WhatsApp via
# Double Tick. The admin sees the full request payload in WhatsApp and
# verifies the visitor by phone before connecting them to the alumnus.
#
# DOUBLETICK_ADMIN_NUMBER must be DIFFERENT from DOUBLETICK_FROM_NUMBER
# — Double Tick cannot send a message from a number to itself. Use the
# TPO's personal WhatsApp or a dedicated placement-cell WhatsApp number.
#
# Format: digits-only with country code, no "+", e.g. "919876543210".
#
# If unset, alumni intro requests still validate + return success to the
# visitor (they get their own WhatsApp confirmation), but the admin is
# NOT notified. A loud warning appears in the Vercel server log. Set
# this env var before going live so the audit trail is intact.
DOUBLETICK_ADMIN_NUMBER=

# 4 Sep 2026 — both alumni-intro messages ride dedicated UTILITY templates
# approved on the BIPE WABA (917310077788); the names are hardcoded in
# lib/doubleTick.ts and these vars only override them:
#   visitor ack  bipe_alumni_intro_received_v1 — 6 slots (EN+HI:
#                first name, alumnus, reference ID ×2)
#   admin alert  bipe_alumni_intro_admin_v1    — 5 slots (reference ID,
#                visitor name, visitor phone, alumnus, purpose)
# A replacement template MUST keep the same slot count, or every send is
# vendor-rejected (that is what silenced this flow from May to Sep 2026).
DOUBLETICK_TEMPLATE_ALUMNI_CONTACT_RECEIVED=
DOUBLETICK_TEMPLATE_ALUMNI_CONTACT_ADMIN=

# -----------------------------------------------------------------------------
# GA4 Data API — powers /admin/dashboard/analytics
# -----------------------------------------------------------------------------
# Lets the admin dashboard surface call / WhatsApp / form-submit event
# counts from Google Analytics 4 via the Data API. The events
# themselves already fire (task #59 wired the OutboundTracker and form
# success paths to gtag); these env vars just expose the read side.
#
# Full setup walk-through: ANALYTICS_SETUP.md
#
# Quick version:
#   1. GA4 → Admin → Property Settings → copy numeric Property ID
#      (NOT the G-XXXX measurement ID; the numeric one looks like
#      "501234567")
#   2. Google Cloud Console → IAM → Service Accounts → create
#      "bipe-ga4-reader" → Keys → Add JSON key → download
#   3. GA4 → Admin → Property Access Management → add the service
#      account email as Viewer
#   4. Paste the three values below
#
# The PRIVATE_KEY env var holds the multi-line PEM with literal \n
# sequences (Vercel preserves them as the four-char string "\n"; the
# code at lib/ga4.ts replaces them with real newlines before signing
# the JWT). Wrap the value in double quotes when pasting.
#
# If any of the three is missing, /admin/dashboard/analytics renders
# the setup-instructions panel instead of trying to call the API.
# The public site is unaffected — these vars are read-only-server-side
# admin tooling.
GA4_PROPERTY_ID=
GA4_SERVICE_ACCOUNT_EMAIL=
GA4_SERVICE_ACCOUNT_PRIVATE_KEY=

# -----------------------------------------------------------------------------
# Meta (Facebook) Pixel — client-side ad/conversion tracking
# -----------------------------------------------------------------------------
# OPTIONAL. components/shell/MetaPixelBeacon.tsx defaults to the live
# pixel 1035125302305497, so the pixel works on deploy without setting
# anything here. Only set this to point a specific environment at a
# different pixel (e.g. a staging/test pixel to keep preview traffic out
# of the production audience). Must be NEXT_PUBLIC_* to reach the browser.
NEXT_PUBLIC_META_PIXEL_ID=
